# Copy this file to .env and fill in your values. Never commit .env.

# --- Gemini ---
GOOGLE_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash
# Per-node overrides; leave blank to use DEFAULT_MODEL (e.g. COMPOSER_MODEL=gemini-2.5-pro)
# Cheaper option: SUPERVISOR_MODEL / CLARIFY_MODEL=gemini-2.5-flash-lite (they only classify and ask).
# Check routing afterwards with a few eval cases, e.g. python -m evals.run_evals --only q-01,m-01,ci-01
SUPERVISOR_MODEL=
CLARIFY_MODEL=
CAR_INFO_MODEL=
QUOTATION_MODEL=
LOCATOR_MODEL=
SERVICE_MODEL=
LEAD_MODEL=
COMPOSER_MODEL=
SUMMARIZE_MODEL=
# Timeout per attempt in seconds (also sent to Gemini as the server-side deadline).
LLM_TIMEOUT_S=60
# Retries after the first attempt, only for transient errors (timeouts, 429, 5xx).
# The wait starts at LLM_RETRY_BASE_DELAY_S and doubles each retry, up to LLM_RETRY_MAX_DELAY_S.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_S=1
LLM_RETRY_MAX_DELAY_S=8

# Thinking budget in tokens per node (Gemini 2.5): 0 = off, -1 = dynamic (model default).
# gemini-2.5-pro can't turn thinking off (minimum 128). For Gemini 3 models the budget is mapped
# to thinking_level (0 -> minimal/low, up to 1024 -> low, more -> medium).
SUPERVISOR_THINKING_BUDGET=0
CLARIFY_THINKING_BUDGET=0
SUMMARIZE_THINKING_BUDGET=0
CAR_INFO_THINKING_BUDGET=512
QUOTATION_THINKING_BUDGET=512
LOCATOR_THINKING_BUDGET=512
SERVICE_THINKING_BUDGET=512
LEAD_THINKING_BUDGET=512
COMPOSER_THINKING_BUDGET=512

# --- Support tickets ---
# What the ticket confirmation promises the customer. This is a business promise: keep it accurate.
SUPPORT_RESPONSE_PROMISE=within 24 hours

# --- Graph ---
# Maximum tool-call rounds per agent for one question; after that the agent stops with a
# "couldn't complete this" answer. The graph's recursion limit is derived from it.
MAX_TOOL_ROUNDS=5

# --- Embeddings and retrieval ---
# Changing EMBEDDING_MODEL or EMBEDDING_DIM requires rebuilding the FAISS index:
#   python -m ingestion.build_index
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
RETRIEVAL_TOP_K=4
# Minimum cosine similarity for a search hit. Re-check with `python -m ingestion.test_retrieval --all`
# after changing the embedding model or adding many documents.
RETRIEVAL_SCORE_THRESHOLD=0.62
# hybrid = vector search + BM25 keyword search, merged with Reciprocal Rank Fusion (RRF); vector = embeddings only.
# The threshold above still decides whether a question is on topic at all (best vector score).
RETRIEVAL_MODE=hybrid
# Results taken from each search before fusion, and the RRF constant (score = sum of 1 / (k + rank)).
RETRIEVAL_CANDIDATES=10
RETRIEVAL_RRF_K=60

# --- Ingestion ---
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# --- Geocoding (OpenStreetMap Nominatim) ---
# Nominatim's usage policy asks for an identifying User-Agent, ideally with contact details.
NOMINATIM_USER_AGENT=skoda-support-agent/0.1

# --- LangSmith tracing (optional) ---
# true = every CLI/API turn is sent to LangSmith as a clickable trace (prompts, replies, tool calls per node).
# Traces leave this machine: phone numbers are masked first (app/observability.py); names and other text
# are not. Get a key at https://smith.langchain.com. Evals are never traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skoda-agent
# Blank = LangSmith's default region; for the EU region use https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

LOG_LEVEL=INFO
